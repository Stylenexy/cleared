{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": [
    "packages/cleared-sdk/**/*.ts",
    "packages/cleared-guard/**/*.ts",
    "web/lib/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tools/**/*.ts"
  ]
}
