# Reference only. No keys are required for the local demo.
PAGAR_NETWORK=local
# Aevum configuration, used only when PAGAR_NETWORK=aevum:
PAGAR_VAULT=
PAGAR_REGISTRY=
PAGAR_AGENT=
PAGAR_DEPLOY_BLOCK=0
# Server-side, optional, chat/completions protocol:
LLM_API_KEY=
LLM_API_URL=https://your-provider.example/v1/chat/completions
LLM_MODEL=invoice-extractor
# Foundry script only. Never NEXT_PUBLIC_, never commit or print the key.
DEPLOYER_PRIVATE_KEY=
