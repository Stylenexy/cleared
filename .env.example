# Optional server process settings. Do not put credentials in NEXT_PUBLIC variables.
# Default: wallet-free sample demo. No credentials required.
CLEARED_NETWORK=demo
# To read configured Aevum testnet contracts, set network=aevum and public addresses:
CLEARED_VAULT=
CLEARED_REGISTRY=
CLEARED_AGENT=
CLEARED_DEPLOY_BLOCK=0
# Optional live extraction; the UI requires explicit opt-in before sending invoice text.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# Reserved for the prepared Foundry deployment script. Do not use for local demo.
DEPLOYER_PRIVATE_KEY=
