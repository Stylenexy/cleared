{
  "name": "pagar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace web",
    "test": "vitest run",
    "demo": "node tools/local-demo.mjs",
    "demo:check": "node tools/local-check.ts",
    "setup": "node tools/setup-solc.mjs && node tools/setup-foundry.mjs",
    "check:contrast": "node tools/check-contrast.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "@types/node": "^24.10.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
